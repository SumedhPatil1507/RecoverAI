# RecoverAI Enterprise – Environment Variables Reference
# =======================================================
# Copy this file to .env for local development.
# .env is in .gitignore — NEVER commit real secrets.
#
# Production secrets must be stored in:
#   AWS Secrets Manager  (key: recoverai-production/app-secrets)
#   HashiCorp Vault      (path: secret/recoverai/production)
# and injected at runtime via the IRSA / ESO pipeline.

# ── Identity ──────────────────────────────────────────────────────────────────
APP_NAME=RecoverAI Enterprise
APP_VERSION=2.0.0
ENVIRONMENT=development          # development | staging | production

# ── Security (REQUIRED) ───────────────────────────────────────────────────────
# Razorpay Dashboard → Settings → Webhooks → Webhook Secret
RAZORPAY_WEBHOOK_SECRET=dev_secret_replace_in_production

# AUDIT_HMAC_KEY: 32-byte random hex string used to sign every audit log entry.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
AUDIT_HMAC_KEY=replace_with_32_byte_random_hex_string_never_commit_this

# ── Razorpay Payment Links API ────────────────────────────────────────────────
# Razorpay Dashboard → Settings → API Keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=replace_with_razorpay_key_secret

# ── AI / LLM (optional — leave blank to use rule engine only) ────────────────
OPENAI_API_KEY=
COPILOT_MODEL=gpt-4o-mini
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=3.0
LLM_MAX_TOKENS=300

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_PATH=recover_ai_enterprise.db
# Optional PostgreSQL deployment adapter configuration.
DATABASE_URL=
ML_MODEL_PATH=recover_ai_lgbm.pkl

# ── A/B Experiment ────────────────────────────────────────────────────────────
AB_VARIANT_PCT=50                # 0-100: % of traffic routed to variant arm

# ── HITL Gate thresholds ─────────────────────────────────────────────────────
HITL_AMOUNT_THRESHOLD_PAISE=5000000    # ₹50,000
HITL_DISCOUNT_THRESHOLD_PCT=10.0
HITL_SCORE_BAND_LOW=0.40
HITL_SCORE_BAND_HIGH=0.60
HITL_REPEAT_THRESHOLD=3

# ── ML Drift detection ────────────────────────────────────────────────────────
DRIFT_CHECK_INTERVAL=200         # check every N scoring calls
DRIFT_WINDOW_SIZE=500            # sliding window size
KS_PVALUE_THRESHOLD=0.05         # KS test p-value below this → drift
PSI_THRESHOLD=0.20               # PSI above this → drift

# ── Runtime ───────────────────────────────────────────────────────────────────
QUEUE_WORKERS=4
MAX_RECOVERY_ATTEMPTS=2
ML_LOW_PRIORITY_THRESHOLD=0.15
MAX_DISCOUNT_PCT=15.0
RECOVERY_WINDOW_HOURS=24

# ── Simulator ─────────────────────────────────────────────────────────────────
WEBHOOK_BASE_URL=http://127.0.0.1:8000
SIMULATOR_INTERVAL_SECONDS=5.0
MIN_TRANSACTION_AMOUNT_PAISE=50000
MAX_TRANSACTION_AMOUNT_PAISE=1500000

# ── Dashboard ─────────────────────────────────────────────────────────────────
DASHBOARD_REFRESH_SECONDS=10

# ── WhatsApp Business Cloud API (Meta) ───────────────────────────────────────
# Meta Developer Portal → WhatsApp → API Setup
WHATSAPP_PHONE_ID=
WHATSAPP_ACCESS_TOKEN=

# ── SMS via Twilio ────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── SMS via MSG91 (alternative) ──────────────────────────────────────────────
MSG91_AUTH_KEY=
MSG91_SENDER_ID=RECVAI

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_PASSWORD=
SMTP_FROM=noreply@recoverai.example.com

# ── Anomaly alerts (optional) ───────────────────────────────────────────────────
SLACK_WEBHOOK_URL=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=noreply@recoverai.example.com
SMTP_TLS=true

# ── Monitoring ────────────────────────────────────────────────────────────────
GRAFANA_PASSWORD=recoverai-dev

# ── Terraform / AWS (CI/CD only — set as GitHub Secrets, not here) ───────────
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=ap-south-1
# ECR_REGISTRY=123456789.dkr.ecr.ap-south-1.amazonaws.com
# EKS_CLUSTER_NAME=recoverai-staging-eks
# TF_VAR_razorpay_webhook_secret=   (same as RAZORPAY_WEBHOOK_SECRET above)
# TF_VAR_openai_api_key=            (same as OPENAI_API_KEY above)
# TF_VAR_audit_hmac_key=            (same as AUDIT_HMAC_KEY above)
