# RecoverAI Enterprise – Environment Variables
# Copy to .env for local development (already in .gitignore)

# ── Security (REQUIRED) ───────────────────────────────────────────────────────
RAZORPAY_WEBHOOK_SECRET=dev_secret_replace_in_production

# ── AI / LLM (optional – leave blank to use rule engine only) ────────────────
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=3.0

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_PATH=recover_ai_enterprise.db
ML_MODEL_PATH=recover_ai_lgbm.pkl

# ── Runtime ───────────────────────────────────────────────────────────────────
ENVIRONMENT=development
QUEUE_WORKERS=4
MAX_RECOVERY_ATTEMPTS=2
ML_LOW_PRIORITY_THRESHOLD=0.15
MAX_DISCOUNT_PCT=15.0

# ── Simulator ─────────────────────────────────────────────────────────────────
WEBHOOK_BASE_URL=http://127.0.0.1:8000
SIMULATOR_INTERVAL_SECONDS=5.0
MIN_TRANSACTION_AMOUNT_PAISE=50000
MAX_TRANSACTION_AMOUNT_PAISE=1500000

# ── Dashboard ─────────────────────────────────────────────────────────────────
DASHBOARD_REFRESH_SECONDS=5
