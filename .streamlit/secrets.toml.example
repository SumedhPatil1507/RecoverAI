# ─────────────────────────────────────────────────────────────────────────────
# RecoverAI Enterprise — Streamlit Cloud Secrets
# ─────────────────────────────────────────────────────────────────────────────
# HOW TO USE:
#   Streamlit Cloud → your app → ⋮ (three dots) → Settings → Secrets
#   Paste everything below (edit the values), then click Save.
#   The app reboots automatically.
#
# For LOCAL development:
#   cp .streamlit/secrets.toml.example .streamlit/secrets.toml
#   (secrets.toml is already in .gitignore — never commit it)
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ───────────────────────────────────────────────────────────────────
ENVIRONMENT   = "production"
APP_VERSION   = "2.0.0"

# ── Database ──────────────────────────────────────────────────────────────────
# /tmp/ is always writable on Streamlit Cloud (repo root is read-only)
DATABASE_PATH = "/tmp/recover_ai_enterprise.db"
ML_MODEL_PATH = "/tmp/recover_ai_lgbm.pkl"

# ── Razorpay ──────────────────────────────────────────────────────────────────
# Get from: Razorpay Dashboard → Settings → Webhooks → Webhook Secret
RAZORPAY_WEBHOOK_SECRET = "dev_secret_replace_in_production"
# Get from: Razorpay Dashboard → Settings → API Keys
RAZORPAY_KEY_ID         = "rzp_test_xxxxxxxxxxxx"
RAZORPAY_KEY_SECRET     = "replace_with_razorpay_key_secret"

# ── OpenAI (optional — leave blank to use the rule engine only) ───────────────
OPENAI_API_KEY = ""
LLM_MODEL      = "gpt-4o-mini"

# ── ML / Recovery tunables ────────────────────────────────────────────────────
ML_LOW_PRIORITY_THRESHOLD = "0.15"
MAX_RECOVERY_ATTEMPTS     = "2"
MAX_DISCOUNT_PCT          = "15.0"
DASHBOARD_REFRESH_SECONDS = "10"

# ── HITL gate thresholds ──────────────────────────────────────────────────────
HITL_AMOUNT_THRESHOLD_PAISE = "5000000"
HITL_DISCOUNT_THRESHOLD_PCT = "10.0"

# ── A/B experiment split ──────────────────────────────────────────────────────
AB_VARIANT_PCT = "50"

# ── Audit ledger HMAC key ─────────────────────────────────────────────────────
# Generate once: python -c "import secrets; print(secrets.token_hex(32))"
# Store this value only here — never in source code
AUDIT_HMAC_KEY = "replace_with_64_char_hex_string"

# ── WhatsApp Business Cloud (Meta) — leave blank for mock mode ────────────────
WHATSAPP_PHONE_ID    = ""
WHATSAPP_ACCESS_TOKEN = ""

# ── Twilio SMS — leave blank for mock mode ────────────────────────────────────
TWILIO_ACCOUNT_SID = ""
TWILIO_AUTH_TOKEN  = ""
TWILIO_FROM_NUMBER = ""

# ── Email (SMTP) — leave blank for mock mode ──────────────────────────────────
# For Gmail: use an App Password (not your account password)
# Gmail App Passwords: myaccount.google.com → Security → 2-Step → App passwords
SMTP_HOST     = "smtp.gmail.com"
SMTP_PORT     = "587"
SMTP_TLS      = "true"
SMTP_USER     = "sumedhp612@gmail.com"
SMTP_PASS     = "your-16-char-gmail-app-password"
SMTP_FROM     = "sumedhp612@gmail.com"

# ── Alert destinations ────────────────────────────────────────────────────────
SLACK_WEBHOOK_URL  = ""
ALERT_EMAIL_FROM   = "sumedhp612@gmail.com"
ALERT_EMAIL_TO     = "sumedhp612@gmail.com"
