# ── Streamlit Cloud Secrets ───────────────────────────────────────────────────
# Paste the contents of this file into:
#   Streamlit Cloud → App Settings → Secrets
# For local dev: copy to .streamlit/secrets.toml (already in .gitignore)

RAZORPAY_WEBHOOK_SECRET = "dev_secret_replace_in_production"

# Leave blank → deterministic rule engine is used (no cost, instant)
OPENAI_API_KEY = ""

LLM_MODEL                    = "gpt-4o-mini"
DATABASE_PATH                = "recover_ai_enterprise.db"
ML_MODEL_PATH                = "recover_ai_lgbm.pkl"
ENVIRONMENT                  = "production"
MAX_RECOVERY_ATTEMPTS        = "2"
ML_LOW_PRIORITY_THRESHOLD    = "0.15"
MAX_DISCOUNT_PCT             = "15.0"
QUEUE_WORKERS                = "4"
WEBHOOK_BASE_URL             = "https://YOUR-API-URL.onrender.com"
SIMULATOR_INTERVAL_SECONDS   = "5.0"
DASHBOARD_REFRESH_SECONDS    = "5"
