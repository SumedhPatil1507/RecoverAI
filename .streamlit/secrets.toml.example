# Copy this file to .streamlit/secrets.toml for local Streamlit Cloud dev
# On Streamlit Cloud: paste these key=value pairs into the Secrets UI

RAZORPAY_WEBHOOK_SECRET = "your_webhook_secret_here"
OPENAI_API_KEY          = ""          # Leave blank to use rule engine
DATABASE_PATH           = "recover_ai.db"
LLM_MODEL               = "gpt-4o-mini"
WEBHOOK_BASE_URL        = "https://your-api-url.com"
