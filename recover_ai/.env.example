# Copy this file to .env and fill in real values

# REQUIRED: Must match the webhook secret configured in your Razorpay dashboard
RAZORPAY_WEBHOOK_SECRET=dev_webhook_secret_change_in_production

# OPTIONAL: Leave blank to use the deterministic rule engine fallback
OPENAI_API_KEY=

# LLM model (only used if OPENAI_API_KEY is set)
LLM_MODEL=gpt-4o-mini

# Database file path (relative or absolute)
DATABASE_PATH=recover_ai.db

# Simulator settings
WEBHOOK_BASE_URL=http://127.0.0.1:8000
SIMULATOR_INTERVAL_SECONDS=5.0
MIN_TRANSACTION_AMOUNT=500.0
MAX_TRANSACTION_AMOUNT=15000.0

# Dashboard auto-refresh interval in seconds
DASHBOARD_REFRESH_SECONDS=5
